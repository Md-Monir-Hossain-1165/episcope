# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# Salt for patient_id hashing (keep this outside the repository)
PATIENT_ID_SALT=change_me_to_a_long_random_string

# Open-Meteo API (no key needed, but keep base URL configurable)
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Paths (override if running in Docker)
BRONZE_PATH=pipeline/bronze
SILVER_PATH=pipeline/silver
GOLD_PATH=pipeline/gold
